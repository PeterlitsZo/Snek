\(match lang
  :zh_CN "直接执行命令，或用 `.text()` 拿到输出："
  :zh_TW "直接執行命令，或用 `.text()` 取得輸出："
  :ja_JP "コマンドを実行するか、`.text()` で出力を取得します。"
  :ko_KR "명령을 실행하거나 `.text()`로 출력을 가져옵니다:"
  :es_ES "Ejecuta un comando o usa `.text()` para obtener su salida:"
  :fr_FR "Exécutez une commande ou récupérez sa sortie avec `.text()` :"
  :de_DE "Führe einen Befehl aus oder lies seine Ausgabe mit `.text()`:"
  :pt_BR "Execute um comando ou use `.text()` para obter a saída:"
  _      "Run a command, or use `.text()` to get its output:")

```ts
import { $ } from "snek";

await $`echo "Hello World"`;

let name = "Snek";
let output = await $`echo ${name}`.text();
console.log(output); // "Snek\n"
```

\(match lang
  :zh_CN "命令输出 JSON 时，可以直接解析："
  :zh_TW "命令輸出 JSON 時，可以直接解析："
  :ja_JP "コマンドが JSON を出力する場合は、そのまま解析できます。"
  :ko_KR "명령이 JSON을 출력하면 바로 파싱할 수 있습니다:"
  :es_ES "Si el comando devuelve JSON, puedes analizarlo directamente:"
  :fr_FR "Si la commande produit du JSON, vous pouvez le parser directement :"
  :de_DE "Wenn der Befehl JSON ausgibt, kannst du es direkt parsen:"
  :pt_BR "Se o comando produzir JSON, você pode interpretá-lo diretamente:"
  _      "If a command outputs JSON, parse it directly:")

```ts
import { $ } from "snek";

let data = await $`echo '{"name":"Snek"}'`.json<{ name: string }>();
console.log(data.name); // "Snek"
```

\(match lang
  :zh_CN "逐行读取输出："
  :zh_TW "逐行讀取輸出："
  :ja_JP "出力を一行ずつ読み取ります。"
  :ko_KR "출력을 한 줄씩 읽습니다:"
  :es_ES "Lee la salida línea por línea:"
  :fr_FR "Lisez la sortie ligne par ligne :"
  :de_DE "Lies die Ausgabe zeilenweise:"
  :pt_BR "Leia a saída linha por linha:"
  _      "Read the output line by line:")

```ts
import { $ } from "snek";

for await (let line of $`printf 'first\nsecond\n'`.lines()) {
  console.log(line); // "first", then "second"
}
```

